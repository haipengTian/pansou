# 发布镜像。需要回滚时改成某个不可变标签，例如 sha-a1b2c3d。
PANSOU_IMAGE=ghcr.io/haipengtian/pansou:production

# 默认仅监听本机，交给 Nginx/Caddy 提供公网 HTTPS。
PANSOU_BIND_ADDRESS=127.0.0.1
PANSOU_HOST_PORT=8888
TZ=Asia/Shanghai

# 搜索来源。按服务器网络和负载逐步增加，不建议一开始启用全部插件。
CHANNELS=tgsearchers7
ASYNC_PLUGIN_ENABLED=true
ENABLED_PLUGINS=pansearch,duoduo,quarksoo,quark4k,zhizhen,shandian

# 缓存
CACHE_ENABLED=true
CACHE_PATH=/app/cache
CACHE_MAX_SIZE=100
CACHE_TTL=60
CACHE_WRITE_STRATEGY=hybrid

# 插件及出口并发
PLUGIN_TIMEOUT=10
ASYNC_RESPONSE_TIMEOUT=4
ASYNC_MAX_BACKGROUND_WORKERS=20
ASYNC_MAX_BACKGROUND_TASKS=100
ASYNC_CACHE_TTL_HOURS=1
OUTBOUND_MAX_CONCURRENCY=128

# 公网部署必须启用认证。复制本文件后务必替换下面两个空值。
# AUTH_USERS 格式：用户名:密码；多个用户以英文逗号分隔。
AUTH_ENABLED=true
AUTH_USERS=
AUTH_TOKEN_EXPIRY=24
AUTH_JWT_SECRET=

# 上游需要代理时取消注释。不要提交包含代理凭据的 deploy/.env。
# PROXY=socks5://127.0.0.1:1080
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 仅在确认上游证书确实不可用且接受中间人风险时开启。
INSECURE_SKIP_TLS_VERIFY=false
